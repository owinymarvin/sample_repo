      <bpmndi:BPMNShape id="Activity_024zke6_di" bpmnElement="Activity_01wmxxa">
        <dc:Bounds x="1060" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_000zs3a_di" bpmnElement="approveDocument">
        <dc:Bounds x="450" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_19blbf9" bpmnElement="Activity_08dadi9">
        <dc:Bounds x="760" y="330" width="100" height="80" />
