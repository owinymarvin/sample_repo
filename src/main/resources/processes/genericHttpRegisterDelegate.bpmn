<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0xryixx" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="HttpServiceDelegate" name="HttpServiceDelegate" isExecutable="true">
    <bpmn:serviceTask id="httpServiceDelegate" name="Create Document" camunda:delegateExpression="${httpRegistrator}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="appName">document</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="location">/document</camunda:inputParameter>
          <camunda:inputParameter name="payload">
            <camunda:map>
              <camunda:entry key="docType">rt</camunda:entry>
              <camunda:entry key="status">SUBMITTED</camunda:entry>
              <camunda:entry key="content">Test Document</camunda:entry>
              <camunda:entry key="tin">129293838</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
          <camunda:outputParameter name="drn">${result.drn}</camunda:outputParameter>
          <camunda:outputParameter name="status">${result.status}</camunda:outputParameter>
          <camunda:outputParameter name="id">${result.id}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12f8uxi</bpmn:incoming>
      <bpmn:outgoing>Flow_1p1w993</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1p1w993" sourceRef="httpServiceDelegate" targetRef="approveDocument" />
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_12f8uxi</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_12f8uxi" sourceRef="StartEvent_1" targetRef="httpServiceDelegate" />
    <bpmn:exclusiveGateway id="Gateway_1i77am9">
      <bpmn:incoming>Flow_1sjb256</bpmn:incoming>
      <bpmn:outgoing>approved</bpmn:outgoing>
      <bpmn:outgoing>rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1sjb256" sourceRef="approveDocument" targetRef="Gateway_1i77am9" />
    <bpmn:sequenceFlow id="approved" name="approved" sourceRef="Gateway_1i77am9" targetRef="Activity_0qilsfq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approveDocument=='APPROVED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="rejected" name="rejected" sourceRef="Gateway_1i77am9" targetRef="Activity_08dadi9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approveDocument=='REJECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17syb1v" sourceRef="Activity_0qilsfq" targetRef="Activity_0b5tgzy" />
    <bpmn:sequenceFlow id="Flow_0ed2xv1" sourceRef="Activity_0b5tgzy" targetRef="Activity_01wmxxa" />
    <bpmn:endEvent id="Event_0qwhtlj">
      <bpmn:incoming>Flow_172upwh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_172upwh" sourceRef="Activity_01wmxxa" targetRef="Event_0qwhtlj" />
    <bpmn:serviceTask id="Activity_0qilsfq" name="Update Doc with Approval Msg" camunda:delegateExpression="${updateApprovedDocumentDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="location">/status</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>approved</bpmn:incoming>
      <bpmn:outgoing>Flow_17syb1v</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_0b5tgzy" name="Script to print some details" scriptFormat="javascript">
      <bpmn:incoming>Flow_17syb1v</bpmn:incoming>
      <bpmn:incoming>Flow_053uput</bpmn:incoming>
      <bpmn:outgoing>Flow_0ed2xv1</bpmn:outgoing>
      <bpmn:script>if (approveDocument === 'APPROVED'){
print('Doc was approved')}
else{
print('Doc was rejected')
}
print(result.status)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_01wmxxa" name="Send Notification" camunda:delegateExpression="${httpRegistrator}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="appName">notification</camunda:inputParameter>
          <camunda:inputParameter name="location">notification/send</camunda:inputParameter>
          <camunda:inputParameter name="payload">
            <camunda:map>
              <camunda:entry key="message">Document status updated successfully + ${result.status}</camunda:entry>
              <camunda:entry key="email">user@example.com</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
          <camunda:outputParameter name="message">${result.status}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ed2xv1</bpmn:incoming>
      <bpmn:outgoing>Flow_172upwh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="approveDocument" name="Approve Document" scriptFormat="javascript">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="approveDocument">REJECTED</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1p1w993</bpmn:incoming>
      <bpmn:outgoing>Flow_1sjb256</bpmn:outgoing>
      <bpmn:script>print('will be implemented later')</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_08dadi9" name="Update Doc with Rejection Msg" camunda:delegateExpression="${updateRejectedDocumentDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="location">/status</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_053uput</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_053uput" sourceRef="Activity_08dadi9" targetRef="Activity_0b5tgzy" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="HttpServiceDelegate">
      <bpmndi:BPMNShape id="Activity_1yo4cm8_di" bpmnElement="httpServiceDelegate">
