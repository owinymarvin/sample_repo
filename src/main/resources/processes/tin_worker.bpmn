    <bpmn:sequenceFlow id="Flow_07l7een" sourceRef="Activity_010yakt" targetRef="Gateway_076ben4" />
    <bpmn:sequenceFlow id="Flow_0iet41b" name="LOW" sourceRef="Gateway_076ben4" targetRef="Activity_1t7bso5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskLevel == 'LOW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18svx2u" name="HIGH or MEDIUM" sourceRef="Gateway_076ben4" targetRef="Activity_0tefqqr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskLevel == "HIGH" || riskLevel == "MEDIUM"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0htn1wm">
      <bpmn:incoming>Flow_1p407ox</bpmn:incoming>
      <bpmn:outgoing>Flow_17jk2xl</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tax8s0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1p407ox" sourceRef="Activity_0tefqqr" targetRef="Gateway_0htn1wm" />
    <bpmn:sequenceFlow id="Flow_17jk2xl" name="Approved" sourceRef="Gateway_0htn1wm" targetRef="Activity_1t7bso5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'APPROVED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1tax8s0" name="Rejected" sourceRef="Gateway_0htn1wm" targetRef="Activity_1wwtvez">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'REJECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0cofcx2" name="End">
      <bpmn:incoming>Flow_1al5x1j</bpmn:incoming>
      <bpmn:incoming>Flow_1l1lfzh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1al5x1j" sourceRef="Activity_1t7bso5" targetRef="Event_0cofcx2" />
    <bpmn:sequenceFlow id="Flow_1l1lfzh" sourceRef="Activity_1wwtvez" targetRef="Event_0cofcx2" />
    <bpmn:serviceTask id="Activity_1vydhak" name="Create App" camunda:delegateExpression="${createAppDelegate}">
      <bpmn:incoming>Flow_1kor8tk</bpmn:incoming>
      <bpmn:outgoing>Flow_0dnu6zw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_010yakt" name="Check Risk Level" camunda:delegateExpression="${checkRiskLevelDelegate}">
      <bpmn:incoming>Flow_0dnu6zw</bpmn:incoming>
      <bpmn:outgoing>Flow_07l7een</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_0tefqqr" name="User Task">
