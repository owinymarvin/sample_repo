    <bpmn:sequenceFlow id="Flow_0dnu6zw" sourceRef="Activity_1vydhak" targetRef="Activity_010yakt" />
    <bpmn:exclusiveGateway id="Gateway_076ben4">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_07l7een</bpmn:incoming>
      <bpmn:outgoing>Flow_0iet41b</bpmn:outgoing>
      <bpmn:outgoing>Flow_18svx2u</bpmn:outgoing>
