        <camunda:inputOutput>
          <camunda:outputParameter name="decision">${decision}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18svx2u</bpmn:incoming>
      <bpmn:outgoing>Flow_1p407ox</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_1wwtvez" name="Clean up And Notify" scriptFormat="javascript">
      <bpmn:incoming>Flow_1tax8s0</bpmn:incoming>
      <bpmn:outgoing>Flow_1l1lfzh</bpmn:outgoing>
      <bpmn:script>print("User Rejected task, Exiting")</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_1t7bso5" name="Log just" scriptFormat="javascript" camunda:resultVariable="print(&#34;User Accepted the task&#34;)">
      <bpmn:incoming>Flow_0iet41b</bpmn:incoming>
      <bpmn:incoming>Flow_17jk2xl</bpmn:incoming>
      <bpmn:outgoing>Flow_1al5x1j</bpmn:outgoing>
      <bpmn:script>print("User Accepted task. Cjs and KFC awaits")</bpmn:script>
    </bpmn:scriptTask>
  </bpmn:process>
